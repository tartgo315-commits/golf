{
  "expo": {
    "name": "GolfMate",
    "slug": "golfmate",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/golf-check-icon.png",
    "scheme": "golfmate",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0d1b11"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourname.golfmate",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "用于扫描记分卡",
        "NSPhotoLibraryUsageDescription": "用于上传球场照片",
        "NSLocationWhenInUseUsageDescription": "用于查找附近球场、自动记录位置与天气（可选）。",
        "NSUserNotificationsUsageDescription": "用于训练提醒和好友通知"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourname.golfmate",
      "versionCode": 1,
      "permissions": ["POST_NOTIFICATIONS", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#0d1b11",
        "foregroundImage": "./assets/images/golf-check-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/golf-check-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "用于搜索附近球场、自动记录位置与天气（可选）。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0d1b11",
          "dark": {
            "backgroundColor": "#0d1b11"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/golf-check-icon.png",
          "color": "#166534"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
